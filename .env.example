# Copia este archivo como .env y ajusta los valores

# Base de datos
# Desarrollo (SQLite, no requiere instalar nada):
DATABASE_URL=sqlite:///./mujer_marinilla.db
# Produccion (PostgreSQL), ejemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/mujer_marinilla

# Seguridad JWT
# OBLIGATORIO: genera un secreto real, la app NO arranca con el valor de
# ejemplo de abajo ni con secretos de menos de 32 caracteres (ver C1 de
# la revision del 16 de sept). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# CORS: origenes permitidos del frontend, separados por coma.
CORS_ORIGINS=http://localhost:3000,https://tu-frontend-en-produccion.com
